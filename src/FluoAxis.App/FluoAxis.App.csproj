<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>FluoAxis.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="..\FluoAxis.PlotProtocol\FluoAxis.PlotProtocol.csproj" />
    <ProjectReference Include="..\FluoAxis.Presentation\FluoAxis.Presentation.csproj" />
    <ProjectReference Include="..\FluoAxis.Visualization\FluoAxis.Visualization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\web\FluoAxis.PlotHost\plot-host.html;..\..\web\FluoAxis.PlotHost\plot-host.css;..\..\web\FluoAxis.PlotHost\plot-host.js">
      <Link>PlotHost\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\web\FluoAxis.PlotHost\vendor\plotly.min.js;..\..\web\FluoAxis.PlotHost\vendor\plotly.LICENSE.txt">
      <Link>PlotHost\vendor\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
