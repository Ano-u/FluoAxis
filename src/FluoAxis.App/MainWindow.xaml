<Window
    x:Class="FluoAxis.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluoAxis">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <NavigationView
        x:Name="PrimaryNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Workbench" Tag="workbench" Icon="Home" />
        <NavigationViewItem x:Name="ExplorerNavigationItem" Content="Explorer" Tag="explorer" Icon="Map" />
        <NavigationViewItem Content="Reports" Tag="reports" Icon="Document" />
      </NavigationView.MenuItems>
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" Padding="20,12" ColumnDefinitions="*,Auto" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel Spacing="2">
            <TextBlock Text="FluoAxis" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="BRAF V600E fluorescence research workstation" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <Border Grid.Column="1" Padding="10,5" CornerRadius="4" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
            <TextBlock Text="RESEARCH USE ONLY" FontSize="12" FontWeight="SemiBold" />
          </Border>
        </Grid>

        <InfoBar x:Name="GlobalInfoBar" Grid.Row="1" Margin="16,8,16,0" IsOpen="False" IsClosable="True" Severity="Error" />

        <TabView Grid.Row="2" IsAddTabButtonVisible="False">
          <TabViewItem x:Name="ProjectTab" Header="Research workspace" IsClosable="False">
            <Grid>
              <Grid x:Name="WorkbenchSurface" ColumnDefinitions="210,*,260" Visibility="Visible">
                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="GUIDED ANALYSIS" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ImportStageButton" Content="1  Import Preview" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnStageClick" Tag="import" />
                    <Button x:Name="MappingStageButton" Content="2  Data Mapping" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnStageClick" Tag="mapping" />
                    <Button x:Name="PlateStageButton" Content="3  Plate Map" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnStageClick" Tag="plate" />
                    <Button x:Name="CalibrationStageButton" Content="4  Calibration" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnStageClick" Tag="calibration" />
                    <Button x:Name="ControlStageButton" Content="5  Control QC" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnStageClick" Tag="control" />
                    <Button x:Name="AnalysisStageButton" Content="6  Sample Analysis" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnStageClick" Tag="analysis" />
                    <Button x:Name="ResultsStageButton" Content="7  Results / Export" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnStageClick" Tag="results" />
                  </StackPanel>
                </Border>

                <Grid Grid.Column="1" Padding="24" RowDefinitions="Auto,*">
                  <StackPanel Spacing="4">
                    <TextBlock x:Name="StageTitle" Text="Import Preview" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="StageSubtitle" Text="Select and inspect a managed fluorescence data source." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                  <Grid Grid.Row="1">
                    <StackPanel x:Name="StageEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="12">
                      <FontIcon Glyph="&#xE8B7;" FontSize="36" HorizontalAlignment="Center" />
                      <TextBlock Text="No managed source has been attached to this Run." TextAlignment="Center" FontSize="17" TextWrapping="Wrap" />
                      <TextBlock Text="Import inspection is available. Run mutation remains disabled until the import transition contract is confirmed." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <Button x:Name="PrimaryStageAction" Content="Inspect source" HorizontalAlignment="Center" IsEnabled="False" />
                    </StackPanel>
                  </Grid>
                </Grid>

                <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="18">
                  <StackPanel Spacing="14">
                    <TextBlock Text="RUN CONTEXT" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="3"><TextBlock Text="Project" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ProjectNameText" Text="Loading..." FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Spacing="3"><TextBlock Text="Run state" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="RunStateText" Text="Loading..." /></StackPanel>
                    <StackPanel Spacing="3"><TextBlock Text="Method" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="MethodText" Text="Loading..." TextWrapping="Wrap" /></StackPanel>
                    <ProgressRing x:Name="WorkbenchProgress" IsActive="True" HorizontalAlignment="Left" />
                    <TextBlock Text="Formal results are calculated only by the deterministic Analysis Engine." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid x:Name="ExplorerSurface" Visibility="Collapsed" RowDefinitions="Auto,*">
                <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
                  <AppBarButton Label="2D scatter" Click="OnScatter2DClick"><AppBarButton.Icon><SymbolIcon Symbol="Map" /></AppBarButton.Icon></AppBarButton>
                  <AppBarButton Label="3D scatter" Click="OnScatter3DClick"><AppBarButton.Icon><SymbolIcon Symbol="View" /></AppBarButton.Icon></AppBarButton>
                  <AppBarButton Label="3D line" Click="OnLine3DClick"><AppBarButton.Icon><SymbolIcon Symbol="Switch" /></AppBarButton.Icon></AppBarButton>
                  <AppBarSeparator />
                  <AppBarButton Label="Export PNG" Click="OnExportPngClick"><AppBarButton.Icon><SymbolIcon Symbol="Save" /></AppBarButton.Icon></AppBarButton>
                  <AppBarButton x:Name="ExportSvgButton" Label="Export SVG" Click="OnExportSvgClick" IsEnabled="False"><AppBarButton.Icon><SymbolIcon Symbol="Save" /></AppBarButton.Icon></AppBarButton>
                  <CommandBar.Content><TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center" Text="Explorer not initialized" /></CommandBar.Content>
                </CommandBar>
                <WebView2 x:Name="PlotWebView" Grid.Row="1" />
                <TextBlock x:Name="PlotFallback" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="Visualization is unavailable." Visibility="Collapsed" />
              </Grid>

              <Grid x:Name="PlaceholderSurface" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                  <TextBlock x:Name="PlaceholderTitle" Text="Reports" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock x:Name="PlaceholderText" Text="This capability is not implemented in the current verified slice." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </Grid>
          </TabViewItem>
        </TabView>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
