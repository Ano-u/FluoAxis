<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WorkbenchWorkspaceBackgroundBrush" Color="#F3F6F8" />
      <SolidColorBrush x:Key="WorkbenchSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="WorkbenchSubtleSurfaceBrush" Color="#EDF2F5" />
      <SolidColorBrush x:Key="WorkbenchBorderBrush" Color="#D4DEE5" />
      <SolidColorBrush x:Key="WorkbenchPrimaryTextBrush" Color="#172B3A" />
      <SolidColorBrush x:Key="WorkbenchSecondaryTextBrush" Color="#526775" />
      <SolidColorBrush x:Key="WorkbenchAccentBrush" Color="#0C6E75" />
      <SolidColorBrush x:Key="WorkbenchAccentSoftBrush" Color="#E0F1F1" />
      <SolidColorBrush x:Key="WorkbenchAccentTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="WorkbenchSuccessBrush" Color="#216B45" />
      <SolidColorBrush x:Key="WorkbenchCautionBrush" Color="#865500" />
      <SolidColorBrush x:Key="WorkbenchDangerBrush" Color="#B42338" />
      <SolidColorBrush x:Key="WorkbenchSelectionBorderBrush" Color="#0C6E75" />

      <!-- Recolor the official accent button states; preserve its template,
           disabled colors, focus visuals, and automation behavior. -->
      <StaticResource x:Key="AccentButtonBackground" ResourceKey="WorkbenchAccentBrush" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#095E65" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#084F56" />
      <StaticResource x:Key="AccentButtonForeground" ResourceKey="WorkbenchAccentTextBrush" />
      <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="WorkbenchAccentTextBrush" />
      <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="WorkbenchAccentTextBrush" />
      <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="WorkbenchAccentBrush" />
      <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="WorkbenchAccentBrush" />
      <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="WorkbenchAccentBrush" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="WorkbenchWorkspaceBackgroundBrush" Color="#111B25" />
      <SolidColorBrush x:Key="WorkbenchSurfaceBrush" Color="#192734" />
      <SolidColorBrush x:Key="WorkbenchSubtleSurfaceBrush" Color="#223442" />
      <SolidColorBrush x:Key="WorkbenchBorderBrush" Color="#43596B" />
      <SolidColorBrush x:Key="WorkbenchPrimaryTextBrush" Color="#F2F6F9" />
      <SolidColorBrush x:Key="WorkbenchSecondaryTextBrush" Color="#B4C5D1" />
      <SolidColorBrush x:Key="WorkbenchAccentBrush" Color="#5ED8DE" />
      <SolidColorBrush x:Key="WorkbenchAccentSoftBrush" Color="#173D43" />
      <SolidColorBrush x:Key="WorkbenchAccentTextBrush" Color="#102A33" />
      <SolidColorBrush x:Key="WorkbenchSuccessBrush" Color="#8BDCAB" />
      <SolidColorBrush x:Key="WorkbenchCautionBrush" Color="#F3CA77" />
      <SolidColorBrush x:Key="WorkbenchDangerBrush" Color="#FF9AA9" />
      <SolidColorBrush x:Key="WorkbenchSelectionBorderBrush" Color="#5ED8DE" />

      <StaticResource x:Key="AccentButtonBackground" ResourceKey="WorkbenchAccentBrush" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#83E1E6" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A7EBEE" />
      <StaticResource x:Key="AccentButtonForeground" ResourceKey="WorkbenchAccentTextBrush" />
      <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="WorkbenchAccentTextBrush" />
      <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="WorkbenchAccentTextBrush" />
      <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="WorkbenchAccentBrush" />
      <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="WorkbenchAccentBrush" />
      <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="WorkbenchAccentBrush" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="WorkbenchWorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="WorkbenchSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="WorkbenchSubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="WorkbenchBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="WorkbenchPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="WorkbenchSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="WorkbenchAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="WorkbenchAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="WorkbenchAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="WorkbenchSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="WorkbenchCautionBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="WorkbenchDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="WorkbenchSelectionBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />

      <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- AccentText is for solid Accent fills. On AccentSoft, use PrimaryText.
       Status colors supplement a visible status label, never replace it. -->
  <Style x:Key="WorkbenchCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource WorkbenchSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource WorkbenchBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style x:Key="WorkbenchSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource WorkbenchPrimaryTextBrush}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="WorkbenchHintStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource WorkbenchSecondaryTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="WorkbenchPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="WorkbenchStageButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource WorkbenchSurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource WorkbenchPrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource WorkbenchBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="60" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
